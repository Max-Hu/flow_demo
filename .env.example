POSTGRES_DB=workflow
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow
VITE_API_URL=http://localhost:8000/api
WORKFLOW_ADMIN_USERNAME=admin
# Generate with: docker compose run --rm api python -m app.security.generate_setup_values
WORKFLOW_ADMIN_PASSWORD_HASH=<argon2id-hash>
WORKFLOW_CREDENTIAL_KEYS={"k1":"<base64-32-byte-key>"}
WORKFLOW_ACTIVE_CREDENTIAL_KEY_ID=k1
# Local mock-service token only. Replace it to rehearse credential rotation.
PARTNER_API_DEMO_TOKEN=flowforge-local-demo-token
